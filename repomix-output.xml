<file path="src/main/java/hu/milliomos/ui/StudioBackdropPane.java">
package hu.milliomos.ui;

import javafx.animation.Animation;
import javafx.animation.KeyFrame;
import javafx.animation.KeyValue;
import javafx.animation.Timeline;
import javafx.scene.Group;
import javafx.scene.Node;
import javafx.scene.effect.BlurType;
import javafx.scene.effect.DropShadow;
import javafx.scene.effect.Glow;
import javafx.scene.layout.Pane;
import javafx.scene.paint.*;
import javafx.scene.shape.*;
import javafx.scene.transform.Rotate;
import javafx.util.Duration;

public class StudioBackdropPane extends Pane {

    public StudioBackdropPane() {
        setPrefSize(920, 620);
        // Sötét 2.5D stúdió tér-gradiens
        setStyle("-fx-background-color: radial-gradient(center 50% 35%, radius 75%, #162447, #0b1124 65%, #050711);");

        // 1. Réteg: Mozgó stúdió reflektorok (Háttér mélység)
        Polygon leftBeam = createSpotlightBeam(220, 0, -18);
        Polygon rightBeam = createSpotlightBeam(700, 0, 18);

        // 2. Réteg: 2.5D Perspektivikus színpadpadló (Ellipszis gyűrűk)
        Group stageFloor = createPerspectiveFloor();

        // 3. Réteg: Bal oldali figura (Műsorvezető + Pult)
        Group hostCharacter = createCharacterRig(230, 260, Color.web("#00d2ff"), Color.web("#1a2a6c"), true);

        // 4. Réteg: Jobb oldali figura (Játékos + Pult)
        Group playerCharacter = createCharacterRig(690, 260, Color.web("#f5af19"), Color.web("#3a1c71"), false);

        getChildren().addAll(leftBeam, rightBeam, stageFloor, hostCharacter, playerCharacter);

        // Reszponzív középre igazítás ablakméretezéskor
        widthProperty().addListener((obs, oldV, newV) -> updateLayoutPositions(
                newV.doubleValue(), getHeight(), stageFloor, hostCharacter, playerCharacter, leftBeam, rightBeam));
        heightProperty().addListener((obs, oldV, newV) -> updateLayoutPositions(
                getWidth(), newV.doubleValue(), stageFloor, hostCharacter, playerCharacter, leftBeam, rightBeam));

        startAmbientAnimations(leftBeam, rightBeam, hostCharacter, playerCharacter);
    }

    private Polygon createSpotlightBeam(double topX, double topY, double initialAngle) {
        Polygon beam = new Polygon(
                topX, topY,
                topX - 180, 620,
                topX + 180, 620
        );
        LinearGradient beamGrad = new LinearGradient(0, 0, 0, 1, true, CycleMethod.NO_CYCLE,
                new Stop(0, Color.rgb(0, 210, 255, 0.22)),
                new Stop(1, Color.rgb(0, 210, 255, 0.0))
        );
        beam.setFill(beamGrad);
        beam.getTransforms().add(new Rotate(initialAngle, topX, topY));
        return beam;
    }

    private Group createPerspectiveFloor() {
        Group floorGroup = new Group();

        // Külső sötét 3D emelvény perem
        Ellipse platformBase = new Ellipse(0, 12, 340, 85);
        platformBase.setFill(Color.web("#070b19"));
        platformBase.setStroke(Color.web("#d4af37", 0.5));
        platformBase.setStrokeWidth(3);
        platformBase.setEffect(new DropShadow(BlurType.GAUSSIAN, Color.rgb(0, 0, 0, 0.85), 35, 0.4, 0, 15));

        // Belső stúdiópadló
        Ellipse mainFloor = new Ellipse(0, 0, 330, 78);
        RadialGradient floorGrad = new RadialGradient(0, 0, 0.5, 0.5, 0.5, true, CycleMethod.NO_CYCLE,
                new Stop(0, Color.web("#1f4068")),
                new Stop(0.7, Color.web("#111d38")),
                new Stop(1, Color.web("#0a1124"))
        );
        mainFloor.setFill(floorGrad);
        mainFloor.setStroke(Color.web("#00d2ff", 0.8));
        mainFloor.setStrokeWidth(2.5);

        // Neon belső gyűrű
        Ellipse innerRing = new Ellipse(0, 0, 210, 48);
        innerRing.setFill(Color.TRANSPARENT);
        innerRing.setStroke(Color.web("#f5af19", 0.65));
        innerRing.setStrokeWidth(1.8);
        innerRing.getStrokeDashArray().addAll(18.0, 10.0);

        floorGroup.getChildren().addAll(platformBase, mainFloor, innerRing);
        return floorGroup;
    }

    private Group createCharacterRig(double x, double y, Color accentNeon, Color suitColor, boolean facingRight) {
        Group rig = new Group();
        rig.setTranslateX(x);
        rig.setTranslateY(y);

        int dir = facingRight ? 1 : -1;
        DropShadow depthShadow = new DropShadow(BlurType.GAUSSIAN, Color.rgb(0, 0, 0, 0.75), 20, 0.3, -dir * 6, 8);

        // --- 1. Karakter felsőtest és fej (2.5D rétegezett vektor) ---
        Group bodyGroup = new Group();

        // Vállak / Zakó (Trapéz 2.5D dőléssel)
        Polygon torso = new Polygon(
                -35, 45,
                35, 45,
                26, -15,
                -26, -15
        );
        LinearGradient suitGrad = new LinearGradient(0, 0, 1, 1, true, CycleMethod.NO_CYCLE,
                new Stop(0, suitColor.brighter()),
                new Stop(1, suitColor.darker().darker())
        );
        torso.setFill(suitGrad);
        torso.setStroke(accentNeon.deriveColor(0, 1, 1, 0.6));
        torso.setStrokeWidth(1.5);

        // Ing / Nyakkendő V-kivágás
        Polygon collar = new Polygon(-8, -15, 8, -15, 0, 12);
        collar.setFill(Color.web("#e6f2ff"));

        // Fej (3D gömbhatású árnyékolással)
        Circle head = new Circle(0, -38, 20);
        RadialGradient headGrad = new RadialGradient(0, 0, facingRight ? 0.65 : 0.35, 0.35, 0.6, true, CycleMethod.NO_CYCLE,
                new Stop(0, Color.web("#ffdbac")),
                new Stop(0.75, Color.web("#d9a17c")),
                new Stop(1, Color.web("#8d5524"))
        );
        head.setFill(headGrad);
        head.setStroke(accentNeon.deriveColor(0, 1, 1, 0.4));
        head.setStrokeWidth(1.2);

        // Karakter karja a pult felé nyúlva
        Path arm = new Path(
                new MoveTo(dir * 12, -5),
                new LineTo(dir * 32, 18),
                new LineTo(dir * 52, 12)
        );
        arm.setStroke(suitColor.brighter());
        arm.setStrokeWidth(11);
        arm.setStrokeLineCap(StrokeLineCap.ROUND);
        arm.setStrokeLineJoin(StrokeLineJoin.ROUND);

        bodyGroup.getChildren().addAll(torso, collar, arm, head);
        bodyGroup.setEffect(depthShadow);

        // --- 2. 2.5D Milliomos Kvízpult és Monitor ---
        Group podiumGroup = new Group();

        // Pult oszlop
        Polygon podiumStand = new Polygon(
                dir * 30, 85,
                dir * 75, 85,
                dir * 62, 18,
                dir * 42, 18
        );
        podiumStand.setFill(new LinearGradient(0, 0, 1, 0, true, CycleMethod.NO_CYCLE,
                new Stop(0, Color.web("#0f172a")),
                new Stop(0.5, Color.web("#1e293b")),
                new Stop(1, Color.web("#090d16"))
        ));
        podiumStand.setStroke(accentNeon);
        podiumStand.setStrokeWidth(1.8);

        // Világító kvíz-monitor a pult tetején (a karakter felé döntve)
        Polygon monitor = new Polygon(
                dir * 35, 16,
                dir * 72, 22,
                dir * 66, -8,
                dir * 42, -12
        );
        monitor.setFill(Color.web("#001f3f"));
        monitor.setStroke(accentNeon);
        monitor.setStrokeWidth(2.2);
        monitor.setEffect(new Glow(0.65));

        podiumGroup.getChildren().addAll(podiumStand, monitor);
        podiumGroup.setEffect(depthShadow);

        rig.getChildren().addAll(bodyGroup, podiumGroup);
        return rig;
    }

    private void updateLayoutPositions(double w, double h, Group floor, Group host, Group player,
                                       Polygon leftBeam, Polygon rightBeam) {
        double centerX = w / 2.0;
        double stageY = h * 0.43;

        floor.setTranslateX(centerX);
        floor.setTranslateY(stageY + 55);

        host.setTranslateX(centerX - 210);
        host.setTranslateY(stageY - 25);

        player.setTranslateX(centerX + 210);
        player.setTranslateY(stageY - 25);

        double offsetX = centerX - 460.0;
        leftBeam.setTranslateX(offsetX);
        rightBeam.setTranslateX(offsetX);
    }

    private void startAmbientAnimations(Polygon leftBeam, Polygon rightBeam, Group host, Group player) {
        Rotate leftRot = (Rotate) leftBeam.getTransforms().get(0);
        Rotate rightRot = (Rotate) rightBeam.getTransforms().get(0);

        Timeline lightsTimeline = new Timeline(
                new KeyFrame(Duration.ZERO,
                        new KeyValue(leftRot.angleProperty(), -22),
                        new KeyValue(rightRot.angleProperty(), 22)),
                new KeyFrame(Duration.seconds(4.5),
                        new KeyValue(leftRot.angleProperty(), -6),
                        new KeyValue(rightRot.angleProperty(), 6))
        );
        lightsTimeline.setAutoReverse(true);
        lightsTimeline.setCycleCount(Animation.INDEFINITE);
        lightsTimeline.play();

        Node hostBody = host.getChildren().get(0);
        Node playerBody = player.getChildren().get(0);

        Timeline idleTimeline = new Timeline(
                new KeyFrame(Duration.ZERO,
                        new KeyValue(hostBody.translateYProperty(), 0),
                        new KeyValue(playerBody.translateYProperty(), -3)),
                new KeyFrame(Duration.seconds(2.2),
                        new KeyValue(hostBody.translateYProperty(), -4),
                        new KeyValue(playerBody.translateYProperty(), 1))
        );
        idleTimeline.setAutoReverse(true);
        idleTimeline.setCycleCount(Animation.INDEFINITE);
        idleTimeline.play();
    }
}
