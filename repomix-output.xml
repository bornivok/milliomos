<file path="src/main/resources/style.css">
/* Globális sötét stúdió téma */
.root {
    -fx-base: #0b1124;
    -fx-background: #0b1124;
    -fx-control-inner-background: #101a36;
    -fx-font-family: "Segoe UI", "Arial", sans-serif;
}

/* Felső TabPane fülek modernizálása */
.tab-pane .tab-header-area .tab-header-background {
    -fx-background-color: linear-gradient(to bottom, #060a17, #101a36);
    -fx-border-color: #d4af37;
    -fx-border-width: 0 0 2 0;
}

.tab {
    -fx-background-color: #142242;
    -fx-background-radius: 8 8 0 0;
    -fx-padding: 8 18;
    -fx-border-color: #2b4478;
    -fx-border-radius: 8 8 0 0;
}

.tab:selected {
    -fx-background-color: linear-gradient(to bottom, #243b6b, #111d38);
    -fx-border-color: #f5af19;
    -fx-border-width: 2 2 0 2;
}

.tab .tab-label {
    -fx-text-fill: #f0f4f8;
    -fx-font-weight: bold;
    -fx-font-size: 14px;
}

/* Lebegő üveghatású (Glassmorphism) regisztrációs és kvíz kártya */
.glass-panel {
    -fx-background-color: rgba(12, 20, 44, 0.78);
    -fx-background-radius: 18;
    -fx-border-color: linear-gradient(to bottom right, #00d2ff, #d4af37);
    -fx-border-width: 2;
    -fx-border-radius: 18;
    -fx-effect: dropshadow(gaussian, rgba(0, 0, 0, 0.85), 25, 0.35, 0, 10);
}

/* 2.5D-s Kérdés Kapszula */
.question-banner {
    -fx-background-color:
            linear-gradient(to bottom, #304e8a 0%, #16264c 48%, #0d1730 52%, #182b54 100%);
    -fx-background-radius: 28;
    -fx-border-color: linear-gradient(to right, #b38728, #fbf5b7, #d4af37, #b38728);
    -fx-border-width: 2.5;
    -fx-border-radius: 28;
    -fx-padding: 14 24;
    -fx-text-fill: #ffffff;
    -fx-font-size: 18px;
    -fx-font-weight: bold;
    -fx-effect: dropshadow(gaussian, rgba(0, 0, 0, 0.9), 18, 0.4, 0, 6);
}

/* 2.5D-s Milliomos Válaszgombok (Térhatású él + Arany keret) */
.answer-button {
    -fx-background-color:
            linear-gradient(to bottom, #2b457d 0%, #15254a 48%, #0d1833 52%, #1a2f5c 100%);
    -fx-background-radius: 24;
    -fx-border-color: #d4af37;
    -fx-border-width: 2;
    -fx-border-radius: 24;
    -fx-text-fill: #ffffff;
    -fx-font-size: 14.5px;
    -fx-font-weight: bold;
    -fx-cursor: hand;
    -fx-effect: dropshadow(gaussian, rgba(0, 0, 0, 0.8), 12, 0.3, 0, 5);
}

/* Hover effekt: 2.5D kiemelkedés és narancs-arany TV-műsor kijelölés */
.answer-button:hover {
    -fx-background-color:
            linear-gradient(to bottom, #f5af19 0%, #d47a00 48%, #b36200 52%, #e68a00 100%);
    -fx-border-color: #ffffff;
    -fx-text-fill: #080d1a;
    -fx-translate-y: -2;
    -fx-effect: dropshadow(gaussian, rgba(245, 175, 25, 0.75), 18, 0.45, 0, 7);
}

/* TV-műsoros megjelölt válasz (Narancs-arany) */
.answer-selected {
    -fx-background-color:
            linear-gradient(to bottom, #f5af19 0%, #d47a00 48%, #b36200 52%, #e68a00 100%) !important;
    -fx-border-color: #ffffff !important;
    -fx-text-fill: #080d1a !important;
    -fx-opacity: 1.0 !important;
}

/* Helyes válasz felvillanás (Smaragdzöld) */
.answer-correct {
    -fx-background-color:
            linear-gradient(to bottom, #2ecc71 0%, #27ae60 48%, #1e8449 52%, #2ecc71 100%) !important;
    -fx-border-color: #ffffff !important;
    -fx-text-fill: #ffffff !important;
    -fx-opacity: 1.0 !important;
    -fx-effect: dropshadow(gaussian, rgba(46, 204, 113, 0.85), 22, 0.5, 0, 0) !important;
}

/* Helytelen válasz felvillanás (Karmazsinpiros) */
.answer-wrong {
    -fx-background-color:
            linear-gradient(to bottom, #e74c3c 0%, #c0392b 48%, #922b21 52%, #e74c3c 100%) !important;
    -fx-border-color: #ffffff !important;
    -fx-text-fill: #ffffff !important;
    -fx-opacity: 1.0 !important;
    -fx-effect: dropshadow(gaussian, rgba(231, 76, 60, 0.85), 22, 0.5, 0, 0) !important;
}

.answer-button:pressed {
    -fx-translate-y: 2;
}

.answer-button:disabled {
    -fx-opacity: 0.32;
}

/* Segítség (Lifeline) 2.5D ovális gombok */
.lifeline-button {
    -fx-background-color: radial-gradient(center 50% 35%, radius 75%, #1e3c72, #0f1c3f);
    -fx-background-radius: 30;
    -fx-border-color: #00d2ff;
    -fx-border-width: 2;
    -fx-border-radius: 30;
    -fx-text-fill: #e0f7fa;
    -fx-font-weight: bold;
    -fx-font-size: 13px;
    -fx-padding: 7 15;
    -fx-cursor: hand;
    -fx-effect: dropshadow(gaussian, rgba(0, 210, 255, 0.4), 12, 0.3, 0, 3);
}

.lifeline-button:hover {
    -fx-border-color: #f5af19;
    -fx-text-fill: #ffffff;
    -fx-translate-y: -2;
}

/* Megállás (Kiszállás) gomb arany kiemeléssel */
.walk-away-button {
    -fx-background-color: radial-gradient(center 50% 35%, radius 75%, #5c3d00, #2b1d00);
    -fx-border-color: #f5af19;
    -fx-text-fill: #ffe8a3;
}

.walk-away-button:hover {
    -fx-background-color: linear-gradient(to bottom, #f5af19, #b36200);
    -fx-border-color: #ffffff;
    -fx-text-fill: #080d1a;
}

/* --- 15 LÉPCSŐS NYEREMÉNYFA (PONT-LÉTRA) --- */
.ladder-step {
    -fx-background-color: rgba(20, 34, 66, 0.55);
    -fx-background-radius: 8;
    -fx-border-color: transparent;
    -fx-border-radius: 8;
    -fx-border-width: 1;
}

.ladder-text {
    -fx-text-fill: #8fa8c8;
    -fx-font-size: 11.5px;
    -fx-font-weight: bold;
}

.ladder-step-milestone .ladder-text {
    -fx-text-fill: #ffffff;
}

.ladder-step-passed {
    -fx-background-color: rgba(39, 174, 96, 0.28);
    -fx-border-color: #2ecc71;
}

.ladder-step-passed .ladder-text {
    -fx-text-fill: #2ecc71;
}

.ladder-step-current {
    -fx-background-color: linear-gradient(to right, #f5af19, #d47a00);
    -fx-border-color: #ffffff;
    -fx-effect: dropshadow(gaussian, rgba(245, 175, 25, 0.75), 10, 0.4, 0, 0);
}

.ladder-step-current .ladder-text {
    -fx-text-fill: #080d1a;
    -fx-font-weight: bold;
}

/* --- 2.5D ANIMÁLT KÖZÖNSÉG OSZLOPDIAGRAM --- */
.audience-chart-pane {
    -fx-background-color: rgba(8, 15, 36, 0.88);
    -fx-border-color: linear-gradient(to bottom, #00d2ff, #d4af37);
    -fx-border-width: 2;
    -fx-border-radius: 16;
    -fx-background-radius: 16;
}

.chart-bar-track {
    -fx-background-color: rgba(5, 9, 22, 0.85);
    -fx-background-radius: 8 8 3 3;
    -fx-border-color: #1e3c72;
    -fx-border-radius: 8 8 3 3;
    -fx-border-width: 1;
}

.chart-bar-fill {
    -fx-background-color:
            linear-gradient(to right, #0072ff 0%, #00d2ff 45%, #80eaff 55%, #005bb5 100%);
    -fx-background-radius: 6 6 2 2;
    -fx-border-color: #b3f0ff;
    -fx-border-width: 1 1 0 1;
    -fx-border-radius: 6 6 2 2;
    -fx-effect: dropshadow(gaussian, rgba(0, 210, 255, 0.55), 10, 0.35, 0, 0);
}

.chart-bar-highest {
    -fx-background-color:
            linear-gradient(to right, #b36200 0%, #f5af19 45%, #fff1a8 55%, #c47100 100%);
    -fx-border-color: #ffffff;
    -fx-effect: dropshadow(gaussian, rgba(245, 175, 25, 0.8), 14, 0.45, 0, 0);
}

.chart-pct-label {
    -fx-text-fill: #ffffff;
    -fx-font-size: 11.5px;
    -fx-font-weight: bold;
}

.chart-axis-label {
    -fx-text-fill: #f5af19;
    -fx-font-size: 12px;
    -fx-font-weight: bold;
}

/* --- SÖTÉT 2.5D TÁBLÁZAT ÉS LISTVIEW --- */
.table-view, .list-view {
    -fx-background-color: #0d162e;
    -fx-border-color: #d4af37;
    -fx-border-width: 1.5;
    -fx-border-radius: 10;
    -fx-background-radius: 10;
}

.table-view .column-header-background {
    -fx-background-color: linear-gradient(to bottom, #1e3c72, #111d38);
}

.table-view .column-header {
    -fx-background-color: transparent;
    -fx-border-color: #2b4478;
}

.table-view .column-header .label {
    -fx-text-fill: #f5af19;
    -fx-font-weight: bold;
}

.table-row-cell, .list-cell {
    -fx-background-color: #101a36;
    -fx-text-fill: #e0f7fa;
}

.table-row-cell:odd, .list-cell:odd {
    -fx-background-color: #152244;
}

.table-row-cell:selected, .list-cell:filled:selected {
    -fx-background-color: linear-gradient(to right, #f5af19, #d47a00);
    -fx-text-fill: #080d1a;
    -fx-font-weight: bold;
}
</file>

