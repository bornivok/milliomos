package hu.milliomos.service;

import hu.milliomos.model.ScoreRecord;
import java.time.LocalDateTime;
import java.time.format.DateTimeFormatter;

public class ScoreCalculator {
    private static final DateTimeFormatter FORMATTER = DateTimeFormatter.ofPattern("yyyy-MM-dd HH:mm");

    public int calculateQuestionReward(int questionIndex) {
        // 1. kérdés: 1000 pont, 2. kérdés: 2000 pont ... 15. kérdés: 15000 pont
        return (questionIndex + 1) * 1000;
    }

    public double calculateTimeMultiplier(int remainingSeconds) {
        // Minden fennmaradt másodperc +0.01-gyel növeli a szorzót (1.00x alapról)
        return Math.round((1.0 + (remainingSeconds * 0.01)) * 100.0) / 100.0;
    }

    public ScoreRecord createFinalRecord(String playerName, int answerPoints, int helpPenalty, int remainingSeconds) {
        int netPoints = Math.max(0, answerPoints - helpPenalty);
        double multiplier = calculateTimeMultiplier(remainingSeconds);
        int finalScore = (int) Math.round(netPoints * multiplier);

        return new ScoreRecord(
                playerName,
                answerPoints,
                helpPenalty,
                remainingSeconds,
                multiplier,
                finalScore,
                LocalDateTime.now().format(FORMATTER)
        );
    }
}
