package hu.milliomos.test;

import hu.milliomos.model.ScoreRecord;
import hu.milliomos.service.ScoreCalculator;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.DisplayName;
import org.junit.jupiter.api.Test;

import static org.junit.jupiter.api.Assertions.*;

public class ScoreCalculatorTest {

    private ScoreCalculator calculator;

    @BeforeEach
    void setUp() {
        calculator = new ScoreCalculator();
    }

    @Test
    @DisplayName("A kérdések jutalma 1000-től 15000-ig lineárisan nő")
    void testCalculateQuestionReward() {
        assertEquals(1000, calculator.calculateQuestionReward(0));
        assertEquals(5000, calculator.calculateQuestionReward(4));
        assertEquals(15000, calculator.calculateQuestionReward(14));
    }

    @Test
    @DisplayName("Az időszorzó másodpercenként +0.01-gyel nő 1.0-s alapról")
    void testCalculateTimeMultiplier() {
        assertEquals(1.00, calculator.calculateTimeMultiplier(0));
        assertEquals(2.20, calculator.calculateTimeMultiplier(120));
        assertEquals(4.00, calculator.calculateTimeMultiplier(300));
    }

    @Test
    @DisplayName("Végső rekord számítása: (válaszPont - segítségLevonás) * időSzorzó")
    void testCreateFinalRecordNormalCase() {
        ScoreRecord record = calculator.createFinalRecord("TesztElek", 10000, 2000, 100);

        assertEquals("TesztElek", record.getPlayerName());
        assertEquals(10000, record.getAnswerPoints());
        assertEquals(2000, record.getHelpPenalty());
        assertEquals(100, record.getRemainingSeconds());
        assertEquals(2.00, record.getTimeMultiplier());
        assertEquals(16000, record.getFinalScore());
        assertNotNull(record.getPlayedAt());
    }

    @Test
    @DisplayName("Ha a segítséglevonás nagyobb, mint a válaszpont, a végső pont 0 marad (nem negatív)")
    void testCreateFinalRecordNeverNegative() {
        ScoreRecord record = calculator.createFinalRecord("Balszerencsés", 1000, 4000, 200);
        assertEquals(0, record.getFinalScore());
    }
}
