<file path="exe-keszito.bat">
@echo off
chcp 65001 >nul
title Legyen Ön is Milliomos - EXE és Telepítő Generáló

set "JDK_BIN=C:\Users\csaba\.jdks\openjdk-25.0.1\bin"
set "JPACKAGE_CMD=jpackage"

if exist "%JDK_BIN%\jpackage.exe" (
    set "JPACKAGE_CMD=%JDK_BIN%\jpackage.exe"
)

echo ========================================================
echo 1. LÉPÉS: Fat JAR ellenőrzése a target mappában...
echo ========================================================
if not exist "target\milliomos-jatek-1.0.0-desktop.jar" (
    echo A JAR még nincs lefordítva, Maven package indítása...
    call mvn clean package -DskipTests
)

if not exist "target\milliomos-jatek-1.0.0-desktop.jar" (
    echo [HIBA] Nem található a target\milliomos-jatek-1.0.0-desktop.jar!
    echo Kérlek, az IntelliJ IDEA jobb oldali Maven paneljén kattints duplán a Lifecycle -> package elemre, majd futtasd újra ezt a fájlt!
    pause
    exit /b 1
)

echo.
echo ========================================================
echo 2. LÉPÉS: Tiszta bemeneti mappa előkészítése...
echo ========================================================
if exist "jpackage-input" rmdir /s /q "jpackage-input"
if exist "dist" rmdir /s /q "dist"
mkdir "jpackage-input"

copy "target\milliomos-jatek-1.0.0-desktop.jar" "jpackage-input\" >nul
if exist "questions.json" copy "questions.json" "jpackage-input\" >nul

echo.
echo ========================================================
echo 3. LÉPÉS: Hordozható Windows .EXE generálása (app-image)
echo ========================================================
"%JPACKAGE_CMD%" ^
  --type app-image ^
  --name "MilliomosJatek" ^
  --app-version "1.0.0" ^
  --vendor "Debreceni Egyetem - Szoftverfejlesztes" ^
  --input "jpackage-input" ^
  --dest "dist" ^
  --main-jar "milliomos-jatek-1.0.0-desktop.jar" ^
  --main-class "hu.milliomos.Launcher" ^
  --java-options "-Dfile.encoding=UTF-8" ^
  --java-options "--enable-native-access=ALL-UNNAMED"

if exist "questions.json" (
    copy "questions.json" "dist\MilliomosJatek\" >nul
)

echo [SIKER] Az önállóan futtatható .exe elkészült itt:
echo         dist\MilliomosJatek\MilliomosJatek.exe

echo.
echo ========================================================
echo 4. LÉPÉS: Windows Telepítő (.exe installer) kísérlete...
echo ========================================================
"%JPACKAGE_CMD%" ^
  --type exe ^
  --name "MilliomosJatek-Telepito" ^
  --app-version "1.0.0" ^
  --vendor "Debreceni Egyetem - Szoftverfejlesztes" ^
  --input "jpackage-input" ^
  --dest "dist" ^
  --main-jar "milliomos-jatek-1.0.0-desktop.jar" ^
  --main-class "hu.milliomos.Launcher" ^
  --win-shortcut ^
  --win-menu ^
  --win-dir-chooser ^
  --java-options "-Dfile.encoding=UTF-8" ^
  --java-options "--enable-native-access=ALL-UNNAMED"

if errorlevel 1 (
    echo.
    echo [MEGJEGYZÉS] A telepítős (Setup .exe) változathoz a WiX Toolset szükséges,
    echo de a hordozható dist\MilliomosJatek\MilliomosJatek.exe már KÉSZ és azonnal indítható!
) else (
    echo [SIKER] A telepítő (.exe) is elkészült a dist\ mappában!
)

rmdir /s /q "jpackage-input"
echo.
pause
</file>

<file path="indito.bat">
@echo off
chcp 65001 >nul
title Legyen Ön is Milliomos - Indító

set "JAR_FILE=target\milliomos-jatek-1.0.0-desktop.jar"
set "JDK25_JAVAW=C:\Users\csaba\.jdks\openjdk-25.0.1\bin\javaw.exe"
set "JVM_ARGS=--enable-native-access=ALL-UNNAMED --sun-misc-unsafe-memory-access=allow"

:: Ha még nem létezik a lefordított Fat JAR, lefordítjuk Maven-nel
if not exist "%JAR_FILE%" (
    echo [INFO] A futtatható JAR fájl még nem létezik. Fordítás folyamatban...
    call mvn clean package -DskipTests
    if errorlevel 1 (
        echo [HIBA] A Maven fordítás sikertelen! Ellenőrizd, hogy a Maven elérhető-e, vagy futtasd az IntelliJ-ből a 'package' lépést!
        pause
        exit /b 1
    )
)

echo [INFO] Legyen Ön is Milliomos indítása...

:: Ha elérhető a gépeden az OpenJDK 25, azt használjuk, különben a rendszer alapértelmezett javaw parancsát
if exist "%JDK25_JAVAW%" (
    start "" "%JDK25_JAVAW%" %JVM_ARGS% -Dfile.encoding=UTF-8 -jar "%JAR_FILE%"
) else (
    start "" javaw -Dfile.encoding=UTF-8 -jar "%JAR_FILE%"
)

exit
</file>

<file path="pom.xml">
<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>hu.milliomos</groupId>
    <artifactId>milliomos-jatek</artifactId>
    <version>1.0.0</version>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <javafx.version>21.0.2</javafx.version>
    </properties>

    <dependencies>
        <!-- JavaFX vezérlők és Windows natív grafikus könyvtárak az asztali .jar/.exe futtatáshoz -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
            <classifier>win</classifier>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-graphics</artifactId>
            <version>${javafx.version}</version>
            <classifier>win</classifier>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-base</artifactId>
            <version>${javafx.version}</version>
            <classifier>win</classifier>
        </dependency>

        <!-- Google Gson a JSON fájlok olvasásához és írásához -->
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.11.0</version>
        </dependency>

        <!-- JUnit 5 az egységtesztekhez (scope nélkül, hogy az src/main/java/hu/milliomos/test alatt is forduljon) -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.2</version>
        </dependency>
    </dependencies>

    <build>
        <!-- Megmondjuk a Mavennek, hogy a teszteket a jelenlegi helyükön (src/main/java/hu/milliomos/test) is keresse -->
        <testSourceDirectory>src/main/java</testSourceDirectory>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>

            <!-- JUnit 5 tesztfuttató plugin -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <includes>
                        <include>**/test/*Test.java</include>
                    </includes>
                </configuration>
            </plugin>

            <!-- Fat JAR generáló plugin az asztali futtatáshoz -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.2</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <shadedArtifactAttached>true</shadedArtifactAttached>
                            <shadedClassifierName>desktop</shadedClassifierName>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>hu.milliomos.Launcher</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
</file>

