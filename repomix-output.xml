package hu.milliomos.ui;

import hu.milliomos.model.ScoreRecord;
import hu.milliomos.repository.ScoreRepository;
import javafx.beans.property.SimpleStringProperty;
import javafx.collections.FXCollections;
import javafx.geometry.Insets;
import javafx.scene.control.Label;
import javafx.scene.control.TableColumn;
import javafx.scene.control.TableView;
import javafx.scene.layout.BorderPane;
import javafx.scene.text.Font;
import javafx.scene.text.FontWeight;

public class ScoreboardTabView extends BorderPane {
    private final ScoreRepository scoreRepository;
    private final TableView<ScoreRecord> table = new TableView<>();

    public ScoreboardTabView(ScoreRepository scoreRepository) {
        this.scoreRepository = scoreRepository;
        setPadding(new Insets(15));

        Label title = new Label("Ranglista és Részletes Pontbontás");
        title.setFont(Font.font("System", FontWeight.BOLD, 20));
        title.setPadding(new Insets(0, 0, 10, 0));
        setTop(title);

        setupColumns();
        setCenter(table);
        refreshTable();
    }

    private void setupColumns() {
        TableColumn<ScoreRecord, String> nameCol = new TableColumn<>("Játékos neve");
        nameCol.setCellValueFactory(c -> new SimpleStringProperty(c.getValue().getPlayerName()));
        nameCol.setPrefWidth(140);

        TableColumn<ScoreRecord, String> ansCol = new TableColumn<>("1. Válaszok pontja");
        ansCol.setCellValueFactory(c -> new SimpleStringProperty(c.getValue().getAnswerPoints() + " p"));
        ansCol.setPrefWidth(140);

        TableColumn<ScoreRecord, String> penCol = new TableColumn<>("2. Segítség levonás");
        penCol.setCellValueFactory(c -> new SimpleStringProperty("-" + c.getValue().getHelpPenalty() + " p"));
        penCol.setPrefWidth(140);

        TableColumn<ScoreRecord, String> timeCol = new TableColumn<>("3. Időbónusz (Szorzó)");
        timeCol.setCellValueFactory(c -> new SimpleStringProperty(
                c.getValue().getRemainingSeconds() + " mp (" + c.getValue().getTimeMultiplier() + "x)"));
        timeCol.setPrefWidth(160);

        TableColumn<ScoreRecord, String> finalCol = new TableColumn<>("Végső Pontszám");
        finalCol.setCellValueFactory(c -> new SimpleStringProperty(c.getValue().getFinalScore() + " PONTSZÁM"));
        finalCol.setPrefWidth(150);

        TableColumn<ScoreRecord, String> dateCol = new TableColumn<>("Dátum");
        dateCol.setCellValueFactory(c -> new SimpleStringProperty(c.getValue().getPlayedAt()));
        dateCol.setPrefWidth(130);

        table.getColumns().addAll(nameCol, ansCol, penCol, timeCol, finalCol, dateCol);
    }

    public void refreshTable() {
        table.setItems(FXCollections.observableArrayList(scoreRepository.findAllSorted()));
    }
}
